{
  "openapi": "3.1.0",
  "info": {
    "title": "Kanban move contract comparison",
    "version": "0.0.0",
    "description": "Partial development document: two existing move endpoints only."
  },
  "paths": {
    "/api/items/{id}/move": {
      "patch": {
        "operationId": "moveItem",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItemMove" } } }
        },
        "responses": {
          "200": {
            "description": "Stored row with optional reindex disclosure",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ItemWrite" } } }
          },
          "400": {
            "description": "Existing validation or domain refusal",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Target not found before handler validation",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Existing global error-handler response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/projects/{id}/move": {
      "patch": {
        "operationId": "moveProject",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Id" } }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectMove" } } }
        },
        "responses": {
          "200": {
            "description": "Stored row with optional reindex disclosure",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectWrite" } } }
          },
          "400": {
            "description": "Existing validation or domain refusal",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "Target not found before handler validation",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Existing global error-handler response",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Id": { "type": "string" },
      "Side": { "enum": ["before", "after"] },
      "PositionScope": { "enum": ["attached-siblings", "workflow", "none"] },
      "ReindexedPosition": {
        "type": "object",
        "required": ["id", "position"],
        "properties": { "id": { "type": "string" }, "position": { "type": "number" } },
        "additionalProperties": false
      },
      "ItemMove": {
        "type": "object",
        "properties": {
          "position": { "not": {} },
          "parentId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "isAttached": { "type": "boolean" },
          "workphaseId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "anchorId": {},
          "side": {},
          "scopeWorkphaseIds": {}
        },
        "additionalProperties": true,
        "allOf": [
          {
            "anyOf": [
              { "required": ["workphaseId"] },
              { "required": ["anchorId"] },
              { "required": ["parentId"] },
              { "required": ["isAttached"] },
              {
                "required": ["scopeWorkphaseIds"],
                "properties": { "scopeWorkphaseIds": { "type": "array", "minItems": 1 } }
              }
            ]
          },
          {
            "if": { "required": ["anchorId"] },
            "then": { "required": ["side"], "properties": { "side": { "enum": ["before", "after"] } } }
          }
        ]
      },
      "ProjectMove": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "position": { "not": {} },
              "parentId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
              "prevId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
              "nextId": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
            },
            "additionalProperties": true
          },
          { "type": "array", "items": {} }
        ]
      },
      "ItemWrite": {
        "type": "object",
        "required": [
          "id",
          "type",
          "parentId",
          "projectId",
          "workphaseId",
          "title",
          "description",
          "position",
          "isAttached",
          "assigneeType",
          "agentId",
          "createdAt",
          "updatedAt",
          "completedAt",
          "positionScope"
        ],
        "properties": {
          "id": { "type": "string" },
          "type": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "parentId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "projectId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "workphaseId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "title": { "type": "string" },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "position": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "isAttached": { "type": "integer" },
          "assigneeType": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "agentId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" },
          "completedAt": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
          "positionScope": { "enum": ["attached-siblings", "workflow", "none"] },
          "reindexed": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "position"],
              "properties": { "id": { "type": "string" }, "position": { "type": "number" } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "ProjectWrite": {
        "type": "object",
        "required": ["id", "parentId", "name", "description", "position", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "parentId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "name": { "type": "string" },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "position": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "createdAt": { "type": "integer" },
          "updatedAt": { "type": "integer" },
          "reindexed": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "position"],
              "properties": { "id": { "type": "string" }, "position": { "type": "number" } },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } },
        "additionalProperties": false
      }
    }
  }
}
