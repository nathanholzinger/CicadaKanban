    "/api/workflows": {
      "get": {
        "operationId": "listWorkflows",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": { "$ref": "#/components/schemas/WorkflowProjectFilter" }
