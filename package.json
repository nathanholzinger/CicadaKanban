{
  "name": "kanbanapp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "test:unit": "npm run test:server && npm run test:client",
    "test:coverage": "npm --prefix server run test:coverage",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck:client": "npm --prefix client run typecheck",
    "typecheck:e2e": "tsc -p tsconfig.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:client && npm run typecheck:e2e",
    "test:all": "npm run test:e2e && npm run test:unit && npm run typecheck",
    "lint": "npm --prefix client run lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
