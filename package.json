{
  "name": "kanbanapp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:server": "npm --prefix server run test",
    "test:client": "npm --prefix client run test",
    "test:scripts": "node --test \"scripts/**/*.test.mts\"",
    "test:unit": "npm run test:server && npm run test:client && npm run test:scripts",
    "test:coverage": "npm --prefix server run test:coverage",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck:client": "npm --prefix client run typecheck",
    "typecheck:root": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:client && npm run typecheck:root",
    "test:all": "npm run test:e2e && npm run test:unit && npm run typecheck",
    "lint:client": "npm --prefix client run lint",
    "lint:server": "npm --prefix server run lint",
    "lint:root": "eslint .",
    "lint": "npm run check:docs && npm run lint:client && npm run lint:server && npm run lint:root",
    "format:check:client": "npm --prefix client run format:check",
    "format:check:server": "prettier --check \"server/**/*.{ts,js,mjs,json}\"",
    "format:check:root": "prettier --check \"tests/**/*.ts\" \"scripts/**/*.{mts,json}\" \"*.{ts,js,mjs,json}\"",
    "format:check": "npm run format:check:client && npm run format:check:server && npm run format:check:root",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit",
    "check:docs": "node scripts/check-docs/main.mts",
    "audit:scope": "node scripts/audit-scope/main.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
