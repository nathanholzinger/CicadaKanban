meta {
  name: Create Workflow
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/workflows
  body: json
  auth: none
}

body:json {
  {
    "name": "My Workflow",
    "projectId": "{{projectId}}",
    "templateId": "{{templateId}}"
  }
}

docs {
  # Create Workflow

  `templateId` (a template from List Workflow Templates) or `sourceWorkflowId`
  (another workflow) names where the new workflow's workphases are copied from.
  Leave both out, or send `null`, for a workflow with no workphases. Both are
  references: one that names no row is a 400, and so is an empty string, which
  is what this request sends until `templateId` is set in the environment.
}
