{
  "groups": [
    {
      "name": "OUT_T",
      "pattern": "\\.test\\.tsx?$|^tests/|^server/tests/|^client/src/test/"
    },
    {
      "name": "INSTRUCTIONS",
      "pattern": "^(?:AGENTS\\.md|client/src/components/workflow/AGENTS\\.md)$"
    },
    {
      "name": "SHARED",
      "pattern": "^client/src/lib/(?:hierarchy|hierarchyPlacement|positionedWrite|dragTargets|isStub)\\.ts$"
    },
    {
      "name": "GESTURE",
      "pattern": "^client/src/components/(?:workflow/(?:useBoardDnd|descendantsProjection|descendantsSection|placement|modalPlacement)|sidebar/useProjectDragReorder)\\.ts$"
    },
    {
      "name": "PROJECT_TREE",
      "pattern": "^client/src/components/sidebar/projectTreeUtils\\.ts$"
    },
    {
      "name": "WRITES",
      "pattern": "^client/src/components/(?:workflow/(?:useItemManagement|itemWriteReconciliation|dragRequest|itemListOps)|sidebar/useProjectCollection)\\.ts$"
    },
    {
      "name": "ROWS",
      "pattern": "^client/src/components/(?:(?:StubRows|KanbanCard|dragChrome|CardList|BandGuides)\\.tsx|cardMetrics\\.ts|sidebar/SortableProjectRow\\.tsx)$"
    },
    {
      "name": "TARGETING",
      "pattern": "^client/src/components/workflow/(?:popSession|dragBands|dragCollision|dragRegions|dragStructure|dragClassification|dragOverlayGeometry|dragTuning)\\.ts$"
    },
    {
      "name": "SHELLS",
      "pattern": "^client/src/components/(?:(?:BoardView|BoardColumn|HierarchyModal|ModalShell|UnsortedBucket)\\.tsx|workflow/(?:\\w+Context|forcedStop|useForcedStop|useSnapTween|usePendingGhostGuard|useLatest)\\.ts|sidebar/(?:sidebarWidth|useSidebarResize|useCollapsedProjects)\\.ts)$"
    },
    {
      "name": "SERVER",
      "pattern": "^server/src/(?:lib/(?:positionResolver|itemTree|itemHierarchy|itemPositionScope|attachedCascade)|routes/(?:items|projects))\\.ts$"
    },
    {
      "name": "OUT",
      "pattern": ""
    }
  ],
  "instances": {
    "correctness": {
      "out": [
        "OUT_T",
        "INSTRUCTIONS",
        "SHARED",
        "GESTURE",
        "PROJECT_TREE",
        "WRITES",
        "ROWS",
        "TARGETING",
        "SHELLS",
        "SERVER",
        "OUT"
      ]
    },
    "drift": {
      "targeting": ["TARGETING"],
      "gesture": ["GESTURE"],
      "writes": ["WRITES", "PROJECT_TREE", "SHARED"],
      "rows": ["ROWS"],
      "shells": ["SHELLS"],
      "server": ["SERVER"],
      "instructions": ["INSTRUCTIONS"],
      "out": ["OUT_T", "OUT"]
    },
    "duplication": {
      "gesture": ["GESTURE", "PROJECT_TREE", "SHARED"],
      "writes": ["WRITES", "PROJECT_TREE", "SHARED"],
      "rows": ["ROWS", "SHARED"],
      "targeting": ["TARGETING", "SHARED"],
      "shells": ["SHELLS", "SHARED"],
      "server": ["SERVER"],
      "out": ["OUT_T", "OUT", "INSTRUCTIONS"]
    },
    "fileresp": {
      "gesture-targeting": ["GESTURE", "TARGETING"],
      "writes-shared": ["WRITES", "PROJECT_TREE", "SHARED"],
      "rows-shells": ["ROWS", "SHELLS"],
      "server": ["SERVER"],
      "out": ["OUT_T", "OUT", "INSTRUCTIONS"]
    }
  },
  "readWhole": [
